{
  "name": "roadtrackerindia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RoadTracker India — a map-first encyclopedia of Indian roads",
  "license": "MIT",
  "homepage": "https://roadtrackerindia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForPublicOrg/roadtrackerindia.git"
  },
  "bugs": {
    "url": "https://github.com/ForPublicOrg/roadtrackerindia/issues"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "news": "node scripts/fetch-news.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && node scripts/fetch-news.mjs && vite build && node scripts/gen-pages.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "migrate": "node scripts/migrate-firestore.mjs",
    "fetch-geometry": "node scripts/fetch-osm-geometry.mjs",
    "tolls": "node scripts/fetch-toll-rates.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.1",
    "@fontsource-variable/inter": "^5.1.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "firebase-admin": "^13.0.0",
    "maplibre-gl": "^5.0.0"
  }
}
