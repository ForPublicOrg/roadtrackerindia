rules_version = '2';

// DENY EVERYTHING. This is deliberate, not an oversight.
//
// The site never talks to Firestore from the browser: there is no Firebase
// client SDK in package.json, and every read/write goes through the serverless
// API (/api/ratings, /api/reports) using the Admin SDK, which bypasses these
// rules entirely. Public read rules would buy the app nothing — while letting
// anyone who learns the project id enumerate the whole 7,750-road rating set
// straight from a browser and bill us for every read.
//
// If you ever add the Firebase *client* SDK back, re-open only the specific
// collections it needs — and remember that `road_ratings` must stay server-only
// regardless: its document ids are salted dedupe hashes, and exposing them lets
// anyone test whether a given (coarse IP + device) has rated a given road.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
