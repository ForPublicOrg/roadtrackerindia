rules_version = '2';

// RoadTracker India — Firestore security rules.
// Deploy from Firebase console → Firestore Database → Rules (see docs/FIREBASE.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // Community road-problem reports (potholes / damage / flooding).
    match /reports/{reportId} {
      allow read: if true;

      // Anyone signed in anonymously can add a well-formed report as themselves.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['pothole', 'damage', 'flooding']
        && request.resource.data.roadId is string
        && request.resource.data.roadId.size() < 100
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 280
        && request.resource.data.lng is number
        && request.resource.data.lat is number
        && request.resource.data.lng > 60 && request.resource.data.lng < 100
        && request.resource.data.lat > 5 && request.resource.data.lat < 38
        && request.resource.data.fixedBy is list
        && request.resource.data.fixedBy.size() == 0
        // must be serverTimestamp() — clients cannot forge/backdate timestamps
        && request.resource.data.createdAt == request.time;

      // Only the reporter can delete their report.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Others may only append their uid to fixedBy ("mark fixed" votes).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fixedBy'])
        && request.resource.data.fixedBy is list
        && request.resource.data.fixedBy.hasAll(resource.data.fixedBy)
        && request.resource.data.fixedBy.size() <= resource.data.fixedBy.size() + 1
        && request.resource.data.fixedBy.hasAny([request.auth.uid]);
    }

    // One rating per road per anonymous user; doc id is "<roadId>_<uid>".
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && ratingId == request.resource.data.roadId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
